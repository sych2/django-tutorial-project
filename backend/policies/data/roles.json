{
  "roles": {
    "admin": {
      "inherits": [],
      "permissions": [
        {"resource": "*", "actions": ["*"]}
      ]
    },
    "employee": {
      "inherits": [],
      "permissions": [
        {"resource": "order", "actions": ["read"]},
        {"resource": "product", "actions": ["read", "update"]}
      ]
    },
    "customer": {
      "inherits": [],
      "permissions": [
        {"resource": "order", "actions": ["create", "read", "update"]}
      ]
    },
    "manager": {
      "inherits": ["employee"],
      "permissions": [
        {"resource": "order", "actions": ["delete"]}
      ]
    }
  }
}
